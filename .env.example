# Copie este arquivo para ".env" (na mesma pasta) e preencha.
# O .env fica só no seu computador: está no .gitignore e não vai para o GitHub.

# Banco no Supabase. Pegue em: Supabase > seu projeto > botão "Connect" > "Session pooler".
# Troque [SENHA] pela senha do banco que você criou no projeto.
# Sem esta linha, o Faturale usa o banco local (data/faturale.sqlite3).
DATABASE_URL=postgresql://postgres.SEU_PROJETO:[SENHA]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Opcionais
# FATURALE_MODO_DEMO=1
# FATURALE_REGRA_GUIAS=maior
# DJANGO_SECRET_KEY=troque-por-uma-frase-longa-e-aleatoria
